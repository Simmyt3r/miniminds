# Server-side connection only. Never expose this value through NEXT_PUBLIC_*.
# For Supabase, use the Transaction pooler URL (port 6543) from Connect.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require

# Use a separate long, random value in every environment.
SECRET_KEY=replace-with-a-long-random-secret
