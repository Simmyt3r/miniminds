# Required outside local development. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-value
# PostgreSQL/Supabase server-side connection string. SQLite is local development only.
DATABASE_URL=postgresql+psycopg://user:password@host:5432/miniminds?sslmode=require
# Set to production for secure cookies and production safeguards.
FLASK_ENV=development
# Optional comma-separated accounts that can access /api/admin.
ADMIN_EMAILS=admin@example.com
